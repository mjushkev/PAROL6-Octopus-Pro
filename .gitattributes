# Auto detect text files and perform LF normalization
* text=auto

# Keep source and scripts consistent across Windows and CI.
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Mechanical and document assets are binary.
*.STL binary
*.stl binary
*.STEP binary
*.step binary
*.pdf binary
*.xlsx binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
